# Copia a .env y cambia TODOS los valores. Nunca subas .env a GitHub.
INDEXER_USERNAME=admin
INDEXER_PASSWORD=CHANGE_ME
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=CHANGE_ME

# Modelo de Ollama para el triaje (tinyllama = TFM original; llama3.2:3b o qwen2.5:3b dan mejor calidad)
SMARTSOC_MODEL=tinyllama
# IPs a procesar separadas por comas; vacío = todas
SMARTSOC_SRC_FILTER=
