<!-- Añadir dentro de <ossec_config> en /var/ossec/etc/ossec.conf del Manager.
     Copiar integration/custom-thehive.py a /var/ossec/integrations/custom-thehive
     (sin extensión), chown root:wazuh y chmod 750. -->
<integration>
  <name>custom-thehive</name>
  <hook_url>http://thehive:9000</hook_url>
  <api_key>REEMPLAZAR_CON_API_KEY_DE_THEHIVE</api_key>
  <level>10</level>
  <alert_format>json</alert_format>
</integration>
